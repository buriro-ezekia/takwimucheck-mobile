# TakwimuCheck local configuration.
# Copy this file to .env.local and keep the real values out of Git.
#
# Local backend examples:
# - Web on this computer: http://localhost:8000
# - Android emulator: http://10.0.2.2:8000
# - Physical phone on the same Wi-Fi: http://YOUR_COMPUTER_LAN_IP:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# RevenueCat public SDK keys only. Never place RevenueCat secret keys in the app.
# During Test Store development, the generic public key is sufficient.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Production builds can later use platform-specific public SDK keys.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
