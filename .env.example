# TakwimuCheck local configuration.
# Copy this file to .env.local and keep the real values out of Git.
#
# Local backend examples:
# - Web on this computer: http://localhost:8000
# - Android emulator: http://10.0.2.2:8000
# - Physical phone on the same Wi-Fi: http://YOUR_COMPUTER_LAN_IP:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Do not add the protected backend API key here or to any EXPO_PUBLIC variable.
# Enter controlled-pilot access keys only through the in-app Settings screen.
# The current implementation holds that key in memory for the active app session only.

# RevenueCat public SDK keys only. Never place RevenueCat secret keys in the app.
# During Test Store development, the generic public key is sufficient for Android and web.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Controlled-pilot identified customer.
# Generate one non-guessable UUID-style value and use the exact same value on Android and web.
# This identifier is not a secret, but it must not be a name, email address or predictable value.
# A public deployment must replace this single pilot identity with authenticated per-user IDs.
EXPO_PUBLIC_REVENUECAT_APP_USER_ID=

# Production builds can later use platform-specific public SDK keys.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
